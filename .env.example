# Copy to .env and fill in real values. .env is gitignored — never commit it.
# The app refuses to start if any of these are missing or malformed.

# PostgreSQL connection string. Get a free one from Neon (https://neon.tech):
# create a project, copy the "Connection string" (it already ends with
# ?sslmode=require). Use the same value locally and on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Session cookie signing key. Must be >= 32 chars of high-entropy random.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-64-hex-chars-of-random"

# Salt for hashing client IPs before they touch the database. >= 16 chars.
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
IP_HASH_SALT="replace-with-32-hex-chars-of-random"

# scrypt hash of the single admin/operator password. Never store the plaintext.
# Generate:  npm run admin:hash -- 'your-strong-admin-password'
ADMIN_PASSWORD_HASH="scrypt:16384:<salt-hex>:<hash-hex>"

# Optional: extra origins (comma-separated) allowed to call mutating API routes,
# e.g. a separate admin domain. Same-origin is always allowed; leave blank normally.
ALLOWED_ORIGINS=""

# ─────────────────────────────────────────────────────────────
# AI VIRTUAL RECEPTIONIST  — all optional.
# With none of these set, the chatbot runs in DEMO MODE (rule-based mock answers).
# Set ONE provider's key to switch to LIVE MODE. Keys are read only on the server.
# ─────────────────────────────────────────────────────────────
# AI_PROVIDER=openai            # openai | anthropic  (auto-detected from the key if omitted)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=gpt-4o-mini          # default: gpt-4o-mini (openai) / claude-3-5-haiku-latest (anthropic)

# ─────────────────────────────────────────────────────────────
# WHATSAPP  — all optional.
# With none set, admin notifications and patient messages are SIMULATED and shown
# only in the admin "WhatsApp Outbox" tab. Set credentials for PRODUCTION MODE.
# ─────────────────────────────────────────────────────────────
# WHATSAPP_PROVIDER=meta                 # meta | twilio
# WHATSAPP_TOKEN=EAAG...                 # Meta permanent token, or Twilio auth token
# WHATSAPP_PHONE_NUMBER_ID=1234567890    # Meta Cloud API phone-number id
# WHATSAPP_ADMIN_NUMBER=+15551234567     # where "NEW APPOINTMENT REQUEST" alerts go
# TWILIO_ACCOUNT_SID=AC...               # only if WHATSAPP_PROVIDER=twilio
# WHATSAPP_FROM=+14155238886             # only if WHATSAPP_PROVIDER=twilio (your WhatsApp sender)
